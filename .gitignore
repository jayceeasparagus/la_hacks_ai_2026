# Secrets and environments
.env
.venv/
backend/.venv/

# Python caches
__pycache__/
*.pyc
.pytest_cache/

# Runtime data: settings, alerts.db and evidence written by the server
backend/data/
# Person 2's compile cache
backend/policy/.cache/

# Footage: the scenes' clips and tracks are checked in so the demo runs from a clone.
# Annotated renders are debug output (and wildtrack's is over GitHub's 100 MB limit).
clips/**/*.annotated.mp4

# Model weights downloaded by ultralytics (it uses the git root as its weights dir)
weights/

# Agent worktrees and OS metadata
.claude/worktrees/
.DS_Store
Thumbs.db

# Downloaded datasets and derived crops (licenses in clips/SOURCES.md)
datasets/
