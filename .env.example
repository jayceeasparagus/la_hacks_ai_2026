# PolicyLens settings template. Copy this file to .env (same folder) and fill in the key.
# .env is git-ignored: never commit a real key. This template must never contain one.

# Gemini API key, used by backend/policy (compiling policies) and backend/verify (crop checks).
# Create one at https://aistudio.google.com/apikey (AI Studio keys come with the Gemini API enabled;
# a Google Cloud key needs the "Generative Language API" enabled and allowed in its API restrictions).
GEMINI_API_KEY=your-key-here
GEMINI_MODEL=gemini-flash-latest

# Gemini on/off switch:
#   0 = real Gemini calls (needs the key above)
#   1 = NO Gemini calls: offline policy fallback + offline fake verifier (free, no network)
# Without a working key the app still runs: compiles fall back offline and checks become manual review.
# A value set in your shell overrides this file, e.g.  POLICYLENS_FAKE_LLM=1 uvicorn app.main:app
POLICYLENS_FAKE_LLM=0

# Gemini time budgets (seconds). Real calls take ~12 s on a new or idle connection, <1 s back to back.
# POLICYLENS_VERIFY_TIMEOUT_S=20     # per crop check; the engine queue waits 1 s longer
# POLICYLENS_COMPILE_TIMEOUT_S=30    # per policy compile, both attempts together

# --- Using Vertex AI instead (e.g. Google Cloud credits) ----------------------------------------
# Vertex AI does not serve the Interactions API; PolicyLens switches to generate_content for you.
# Option A, Vertex AI "express mode" API key (Vertex AI Studio / Cloud console > Vertex AI > API keys):
#   GOOGLE_GENAI_USE_VERTEXAI=true
#   GOOGLE_API_KEY=your-vertex-api-key
#   GEMINI_MODEL=gemini-2.5-flash        # must be a Vertex model name; "gemini-flash-latest" is not one
# Option B, Vertex AI with a Google Cloud project (after: gcloud auth application-default login):
#   GOOGLE_GENAI_USE_VERTEXAI=true
#   GOOGLE_CLOUD_PROJECT=your-project-id
#   GOOGLE_CLOUD_LOCATION=us-central1
#   GEMINI_MODEL=gemini-2.5-flash
# Then check it end to end from backend/:  python -m policy.check_gemini
